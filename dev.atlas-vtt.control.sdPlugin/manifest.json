{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "dev.atlas-vtt.control",
  "Name": "Atlas VTT Control",
  "Version": "0.2.1.0",
  "Author": "Atlas VTT",
  "Description": "Control Atlas VTT from your Stream Deck: play moods, stop, pause, skip and set levels; start combat and roll initiative; present the map, freeze the players' camera, hide the map, show images and take them back; roll saved dice. Keys show what plays and light up while it does.",
  "URL": "https://atlas-vtt.dev",
  "SupportURL": "https://github.com/atlas-vtt/atlas-vtt-streamdeck/issues",
  "Icon": "imgs/plugin/icon",
  "Category": "Atlas VTT Control",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "Actions": [
    {
      "UUID": "dev.atlas-vtt.control.mood",
      "Name": "Play mood",
      "Tooltip": "Plays one of your Atlas moods; its key lights up while the mood plays.",
      "Icon": "imgs/actions/mood",
      "PropertyInspectorPath": "ui/mood.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/mood",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.stop-all",
      "Name": "Stop all",
      "Tooltip": "Stops all music and ambience; press again to bring it back.",
      "Icon": "imgs/actions/stop-all",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/stop-all",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.play-pause",
      "Name": "Play / pause music",
      "Tooltip": "Pauses the music where it is and plays it on from there; the ambience goes on.",
      "Icon": "imgs/actions/play-pause",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/play-pause",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.next-track",
      "Name": "Next track",
      "Tooltip": "Skips to the next track of the music.",
      "Icon": "imgs/actions/next-track",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/next-track",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.previous-track",
      "Name": "Previous track",
      "Tooltip": "Goes back to the start of the track, or to the one before it.",
      "Icon": "imgs/actions/previous-track",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/previous-track",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.shuffle",
      "Name": "Shuffle",
      "Tooltip": "Switches shuffle of the music on or off.",
      "Icon": "imgs/actions/shuffle",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/shuffle",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.repeat",
      "Name": "Repeat",
      "Tooltip": "Repeats the list, one track, or nothing.",
      "Icon": "imgs/actions/repeat",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/repeat",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.mute-music",
      "Name": "Mute music",
      "Tooltip": "Mutes the music while the ambience plays on.",
      "Icon": "imgs/actions/mute-music",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/mute-music",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.volume",
      "Name": "Volume",
      "Tooltip": "Changes a level: master, music, ambience, or the music in the mix. Turn a Stream Deck + dial, push it for 0 dB.",
      "Icon": "imgs/actions/volume",
      "PropertyInspectorPath": "ui/volume.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/keys/volume",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "$B1",
        "Icon": "imgs/actions/volume",
        "TriggerDescription": {
          "Rotate": "Change the level",
          "Push": "Back to 0 dB",
          "Touch": "Back to 0 dB"
        }
      }
    },
    {
      "UUID": "dev.atlas-vtt.control.combat",
      "Name": "Start / end combat",
      "Tooltip": "Starts the fight on the map in front of you, or ends the one that runs; lit with the round while a fight runs.",
      "Icon": "imgs/actions/combat",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/combat",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.roll-initiative",
      "Name": "Roll initiative",
      "Tooltip": "Rolls every combatant's initiative, as the tracker's Roll button does.",
      "Icon": "imgs/actions/roll-initiative",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/roll-initiative",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.present",
      "Name": "Present map",
      "Tooltip": "Shows players the map in front of you, opening the player window; lit while they see it.",
      "Icon": "imgs/actions/present",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/present",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.freeze",
      "Name": "Freeze camera",
      "Tooltip": "Keeps players on the view they see now; press again to let it follow you.",
      "Icon": "imgs/actions/freeze",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/freeze",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.curtain",
      "Name": "Hide the map",
      "Tooltip": "Lowers the curtain in the player window, so players see black; press again to reveal the map.",
      "Icon": "imgs/actions/curtain",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/curtain",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.handout",
      "Name": "Show / take back image",
      "Tooltip": "Shows players the image under the pointer in Obsidian; while they see an image or loot, takes it back.",
      "Icon": "imgs/actions/handout",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/handout",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.roll",
      "Name": "Roll dice",
      "Tooltip": "Rolls one of the saved rolls of the Atlas map in front, as the dice tray does.",
      "Icon": "imgs/actions/roll",
      "PropertyInspectorPath": "ui/roll.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/roll",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "UUID": "dev.atlas-vtt.control.share-rolls",
      "Name": "Show my rolls to players",
      "Tooltip": "Switches whether players see your dice rolls; lit while they do.",
      "Icon": "imgs/actions/share-rolls",
      "PropertyInspectorPath": "ui/control.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/keys/share-rolls",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    }
  ]
}