{
  "name": "atlas-vtt-streamdeck",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Stream Deck plugin that runs the Atlas VTT table: music and ambience, combat, the player window, handouts and dice.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate": "streamdeck validate dev.atlas-vtt.control.sdPlugin",
    "pack": "npm run build && streamdeck pack dev.atlas-vtt.control.sdPlugin --output dist --force",
    "link": "streamdeck link dev.atlas-vtt.control.sdPlugin"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.6",
    "@elgato/utils": "0.7.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  }
}
